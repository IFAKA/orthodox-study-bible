# Copy to .env and fill in your values. The .env file is git-ignored.
#
# Ollama AI chat (all optional). Defaults target a local Ollama daemon.

# Local default — leave unset to use http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Local default model
# OLLAMA_MODEL=llama3.2:3b

# --- Ollama Cloud ---
# To use hosted models instead of a local daemon, set all three:
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your-api-key
# OLLAMA_MODEL=gpt-oss:120b
